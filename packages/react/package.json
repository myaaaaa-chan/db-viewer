{
  "name": "@myaaaaa_chan/db-viewer-react",
  "version": "0.1.0",
  "description": "React components for browsing a database (schema tree, data grid, SQL editor) in your web app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myaaaaa-chan/db-viewer.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/myaaaaa-chan/db-viewer#readme",
  "bugs": {
    "url": "https://github.com/myaaaaa-chan/db-viewer/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vite --config dev/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@myaaaaa_chan/db-viewer-core": "workspace:*",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "i18next": "^27.1.1",
    "react-i18next": "^18.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "4.1.9",
    "playwright": "1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vitest-browser-react": "^2.3.0"
  }
}
