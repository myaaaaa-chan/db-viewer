{
  "name": "@myaaaaa_chan/db-viewer-core",
  "version": "0.1.0",
  "description": "Types, RPC schemas, Result, DataSource and pure SQL helpers shared by the db-viewer packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myaaaaa-chan/db-viewer.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/myaaaaa-chan/db-viewer#readme",
  "bugs": {
    "url": "https://github.com/myaaaaa-chan/db-viewer/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
