{
  "name": "@myaaaaa_chan/db-viewer-cli",
  "version": "0.1.0",
  "description": "Run db-viewer from the command line: browse tables and run SQL on PostgreSQL or SQLite in your browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "db-viewer": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@myaaaaa_chan/db-viewer-core": "workspace:*",
    "@myaaaaa_chan/db-viewer-server": "workspace:*",
    "better-sqlite3": "^13.1.1",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1"
  },
  "devDependencies": {
    "@myaaaaa_chan/db-viewer-react": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  }
}
