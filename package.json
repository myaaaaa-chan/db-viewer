{
  "name": "db-viewer",
  "private": true,
  "description": "DBeaver-like database viewer for web apps (monorepo root).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @myaaaaa_chan/db-viewer-e2e test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@types/node": "^20.19.0",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "unrun": "^0.3.1",
    "vitest": "4.1.9"
  }
}
